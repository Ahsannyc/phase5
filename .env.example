# ===========================
# Phase 4 Deployment Environment
# ===========================
#
# Copy this file to .env and fill in actual values
# NEVER commit .env to Git (it's in .gitignore)
# For Kubernetes: Set these as Kubernetes Secrets
#
# ===========================
# Database
# ===========================
DATABASE_URL=postgresql://user:password@neon.tech:5432/tododb?sslmode=require

# ===========================
# Authentication
# ===========================
BETTER_AUTH_SECRET=your-secret-key-here-min-32-chars

# ===========================
# AI & LLM APIs
# ===========================
COHERE_API_KEY=your-cohere-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# ===========================
# Frontend Configuration
# ===========================
NEXT_PUBLIC_OPENAI_DOMAIN_KEY=your-domain-key-for-chatkit

# ===========================
# Backend Configuration
# ===========================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development

# ===========================
# Optional: Docker Compose
# ===========================
COMPOSE_PROJECT_NAME=todo-app
FRONTEND_PORT=3000
BACKEND_PORT=8000
